Package: PatientGenerator
Type: Package
Title: A Generator of Patient Synthetic Data for the OMOP-CDM
Version: 0.1.2
Authors@R: c(
    person("Cesar", "Barboza", , "c.barboza@darwin-eu.org", role = "aut", comment = c(ORCID = "0009-0002-4453-3071")),
