Package: PatientGenerator
Type: Package
Title: Generator of Synthetic Patient Data for the OMOP Common Data Model
Version: 0.2.0
Authors@R: c(
    person("Cesar", "Barboza", , "c.barboza@mi-erasmusmc.nl", role = c("aut", "cre"), comment = c(ORCID = "0009-0002-4453-3071")),
